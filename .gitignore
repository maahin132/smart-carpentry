# ==========================================
# Smart Carpentry - Git Ignore
# ==========================================

# Environment variables
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend builds
frontend/dist/
frontend/build/
frontend/.vite/

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Django
backend/db.sqlite3
backend/.pytest_cache/
backend/staticfiles/
backend/media/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Build / cache
.cache/
.parcel-cache/

# Local development
*.local